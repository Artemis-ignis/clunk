{
  "name": "clunk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run typecheck && npm run core:test && npm run surface:test && npm run profile:test && npm run generation:test && npm run assetops:test && npm run collaboration:test && npm run build && node --test tests/rendered-html.test.mjs tests/auth-dashboard-contract.test.mjs tests/agents-contract.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "core:test": "tsx tests/core.test.ts && tsx tests/asset-inspection-evidence.test.ts",
    "surface:test": "tsx tests/surface-parity.test.ts",
    "profile:test": "tsx tests/custom-profile.test.ts",
    "generation:test": "tsx tests/assetops-generation.test.ts",
    "assetops:2d:test": "tsx tests/assetops-2d.test.ts",
    "assetops:pipeline:test": "tsx tests/assetops-pipeline.test.ts",
    "assetops:bundle:test": "tsx tests/assetops-bundle-contract.test.ts",
    "assetops:api:test": "node --test tests/assetops-api-contract.test.mjs",
    "assetops:texture:test": "node --test tests/texture-audit-contract.test.mjs",
    "assetops:test": "npm run assetops:2d:test && npm run assetops:pipeline:test && npm run assetops:bundle:test && npm run assetops:api:test && npm run assetops:texture:test",
    "collaboration:test": "tsx tests/collaboration-contract.test.ts && tsx tests/collaboration-acceptance.test.ts && tsx tests/collaboration-api-runtime.test.ts && tsx tests/asset-inspection-evidence-api.test.ts && tsx tests/mcp-http-contract.test.ts && tsx tests/mcp-api-key.test.ts && node --test tests/collaboration-api.test.mjs tests/frame-manifest-cli.test.mjs tests/mcp-stdio.test.mjs",
    "api:smoke": "tsx scripts/api-credit-smoke.ts",
    "e2e": "node scripts/e2e.mjs",
    "generate:samples": "node scripts/generate-sample-assets.mjs",
    "asset:readability": "node scripts/texture-audit-cli.mjs",
    "asset:ui-readability": "node scripts/ui-readability-cli.mjs",
    "asset:evidence": "tsx scripts/asset-inspection-evidence-cli.ts",
    "asset:generate": "tsx scripts/assetops-generate.ts",
    "collaboration:frame-manifest": "tsx scripts/frame-manifest-cli.ts",
    "asset:inspect": "tsx scripts/assetops-inspect-cli.ts",
    "clunk": "tsx scripts/clunk-cli.ts",
    "mcp": "tsx integrations/mcp/server.ts",
    "site:preflight": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\site-preflight.ps1",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {

{
  "name": "clunk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run typecheck && npm run core:test && npm run surface:test && npm run profile:test && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .static-preview --ignore-pattern bin --ignore-pattern \"**/clunk-mcp.mjs\"",
    "typecheck": "tsc --noEmit",
    "core:test": "tsx tests/core.test.ts",
    "surface:test": "tsx tests/surface-parity.test.ts",
    "profile:test": "tsx tests/custom-profile.test.ts",
    "api:smoke": "tsx scripts/api-credit-smoke.ts",
    "api:verify-smoke": "tsx scripts/api-verification-smoke.ts",
    "e2e": "node scripts/e2e.mjs",
    "generate:samples": "node scripts/generate-sample-assets.mjs",
    "clunk": "tsx scripts/clunk-cli.ts",
    "mcp": "tsx integrations/mcp/server.ts",
    "site:preflight": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\site-preflight.ps1",
    "db:generate": "drizzle-kit generate",
    "build:mcp": "node scripts/build-mcp-bundle.mjs",
    "qa:render": "node scripts/qa-run-flow.mjs scripts/playwright-render-audit-flow.js"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/three": "^0.179.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.33.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.179.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",

    "asset:og": "node scripts/render-og.mjs",
    "scene:budget": "node scripts/scene-budget-cli.mjs",
    "asset:palette": "tsx scripts/palette-cli.ts",
    "asset:palette:index": "tsx scripts/palette-index-cli.ts",
    "market:verify": "tsx scripts/market-verify-cli.ts",
    "cf:usage": "node scripts/cf-usage-cli.mjs",

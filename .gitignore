# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.netlify/
/.output/
node_modules/.nitro/
/.wrangler/
/outputs/
/work/
/.playwright-cli/
/.clunk-evidence/

# local secrets
.dev.vars

# machine-local tooling & generated previews
/.agents/
/.static-preview/
/skills-lock.json

# local evidence captures & personal documents
/output/
/*.mp4
/*.pdf
.qa-key.local
public/market/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Wrangler/Miniflare local secrets. CLUNK_VERIFY_PRIVATE_KEY lives here during development
# and is a signing key: it must never reach the repository.
.dev.vars
.dev.vars.*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.playwright-cli/
/.clunk-evidence/
/.static-preview/
/docs/application/
/output/
